{
  "name": "JAGA-KLAIM",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "initializeCommand": "test -f .env || cp .env.example .env",
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.env"],
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/api",
    "UV_LINK_MODE": "copy",
    "UV_PYTHON_DOWNLOADS": "never"
  },
  "remoteEnv": { "API_INTERNAL_URL": "http://localhost:8000" },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "client (Next.js)" },
    "8000": { "label": "api (FastAPI)" }
  },
  "postCreateCommand": "uv sync --project api --frozen && cd client && bun install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/api/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "typescript.tsdk": "client/node_modules/typescript/lib"
      }
    }
  }
}
